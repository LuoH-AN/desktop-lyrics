<?xml version="1.0" encoding="utf-8"?>
<!-- 主页：全屏歌词 WebView + 权限引导浮层（未授权/未开启时显示） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <WebView
        android:id="@+id/lyric_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 权限/开启引导浮层 -->
    <LinearLayout
        android:id="@+id/gate_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingEnd="34dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="桌面歌词"
            android:textColor="@color/text_primary"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/gate_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="需要通知使用权与悬浮窗权限"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/gate_listener"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_seg_shell"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="① 授予通知使用权"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/gate_overlay_perm"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_seg_shell"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="② 允许悬浮窗"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/gate_start"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_flat_button"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="开启歌词悬浮窗"
                android:textAllCaps="false"
                android:textColor="@color/text_on_accent"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/gate_settings_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:padding="8dp"
            android:text="设置"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
